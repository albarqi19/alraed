# ══════════════════════════════════════════════════════════════
#  متغيّرات زاحف «الرائد»
# ══════════════════════════════════════════════════════════════
#  انسخ هذا الملفّ إلى e2e/.env واملأه، أو اضبط المتغيّرات في طرفيّتك.
#  ملفّ e2e/.env مستبعَدٌ من git — فلا تُرفَع كلمات مرورٍ إلى المستودع.
#
#  ⚠ الافتراضات كلُّها محلّية. الزاحف يضغط أزراراً، ولا يُوجَّه إلى الإنتاج
#    أبداً. أيّ عنوانٍ غير محلّيٍّ يُرفض ما لم يُضبط E2E_ALLOW_REMOTE=1 صراحةً.

# ── العناوين ──────────────────────────────────────────────────
# الفرونت المزحوف عليه.
#
# ⚠ اكتب 127.0.0.1 لا localhost. على ويندوز يُحلّ «localhost» إلى IPv6 أوّلاً،
#   وقد يكون المنفذ محجوزاً هناك بمشروعٍ آخر بينما معاينتُك على IPv4 — فيزحف
#   الزاحف على تطبيقٍ غير تطبيقك. (وقع هذا فعلاً؛ ولذلك وُجد حارس الهُويّة.)
#   تحقّق من حرّية المنفذ: netstat -ano | findstr :3000
E2E_BASE_URL=http://127.0.0.1:3000

# الباك المحلّي العامل على قاعدة attendance_system_test
E2E_API_BASE_URL=http://127.0.0.1:8010/api

# إقرارٌ صريحٌ بالزحف على عنوانٍ غير محلّي. اتركه فارغاً.
# E2E_ALLOW_REMOTE=

# علامةٌ يتحقّق منها حارس الهُويّة في صفحة الهدف. لا تغيّرها إلا إن غيّرتَ
# عنوان الصفحة في index.html.
# E2E_APP_MARKER=نظام الرائد للإدارة المدرسية

# ── حمولة البذرة — المصدر الأوثق ───────────────────────────────
# مخرَجُ:  DB_DATABASE=attendance_system_test php artisan e2e:seed --quiet-seeders
# منها تُقرأ بياناتُ الدخول للأدوار الخمسة، ومعرّفاتُ بارامترات المسارات،
# والتعيينُ الخاصّ بكلّ مسارٍ على حدة (route_params).
# بلا هذا الملفّ تعمل العدّة بمتغيّرات البيئة وحدها — بتغطيةٍ أقلّ.
E2E_SEED_FILE=./e2e/generated/seed-payload.json

# ── تجاوزاتٌ يدوية (اختيارية) ──────────────────────────────────
# كلُّ ما يلي **يتقدّم** على حمولة البذرة. اتركه فارغاً ما لم تحتج تجاوزاً.

# E2E_ADMIN_NATIONAL_ID=
# E2E_ADMIN_PASSWORD=
# E2E_TEACHER_NATIONAL_ID=
# E2E_TEACHER_PASSWORD=
# E2E_SUPER_ADMIN_NATIONAL_ID=
# E2E_SUPER_ADMIN_PASSWORD=
# بوابة وليّ الأمر: هويّة الطالب وآخر أربعة أرقامٍ من جوّال الوليّ (لا كلمة مرور)
# E2E_GUARDIAN_STUDENT_NATIONAL_ID=
# E2E_GUARDIAN_PHONE_LAST4=

# معرّفاتُ بارامترات المسارات. ما لا قيمة له — لا في البيئة ولا في الحمولة —
# يُسجَّل في التقرير «متخطّى — لا بيانات»، ولا يُحذف صامتاً.
# E2E_STUDENT_ID=
# E2E_TEACHER_ID=
# E2E_CASE_ID=
# E2E_PLAN_ID=
# E2E_SESSION_ID=
# E2E_FORM_ID=
# E2E_VIOLATION_ID=
# E2E_REFERRAL_ID=
# E2E_GENERIC_ID=
# E2E_GUIDE_TYPE=procedural
# رمزٌ حقيقيّ لرابطٍ عامّ (عذر غياب أو ردّ وليّ أمر)
# E2E_PUBLIC_TOKEN=

# ── ضبط السلوك ────────────────────────────────────────────────
# مهلة تحميل الصفحة (مللي ثانية). تجاوزُها يُسجَّل عطلاً.
# E2E_PAGE_TIMEOUT=25000

# مهلة الاختبار الواحد (تحميل + استقرار + أزرار).
# ارفعها ولا تخفضها: `php artisan serve` خادمٌ متسلسل، وتجاوزُ هذه المهلة يُسقط
# الاختبار بلا مرفقةِ نتيجة — فتختفي الصفحة من التقرير أصلاً، لا «سليمة» ولا
# «معطّلة» بل غائبة. وذلك أسوأ من إنذارٍ كاذب.
E2E_TEST_TIMEOUT=150000

# عدد العمّال — 2 إلى 4. الزاحف يضرب باكاً محلّياً واحداً.
# E2E_WORKERS=3
# محاولةٌ ثانيةٌ واحدةٌ عند فشل الشبكة العابر
# E2E_RETRIES=1
# تعطيل تجربة الأزرار (زحفُ تحميلٍ فقط، أسرع)
# E2E_PROBE_BUTTONS=false
# أقصى عدد أزرارٍ تُجرَّب في الصفحة الواحدة
# E2E_MAX_BUTTONS=6
