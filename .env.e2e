# ══════════════════════════════════════════════════════════════
#  بيئةُ بناءِ «هدف الزحف» — لا تُستعمل في نشرٍ حقيقيّ
# ══════════════════════════════════════════════════════════════
#  تُقرأ فقط حين يُبنى الفرونت بـ `vite build --mode e2e`.
#  لا تمسّ بناءَ الإنتاج على Vercel ولا `npm run build` العاديّ إطلاقاً.
#
#  لماذا تلزم؟ لأن عنوان الـ API **يُخبَز في الحزمة وقت البناء**. فلو بُنيت
#  الحزمة بملفّ .env الأصليّ — وهو يشير إلى api.brqq.site — لزحف الزاحف على
#  واجهةٍ تخاطب **الإنتاج** وهو يظنّ نفسه محلّياً. وهذا الملفّ يقطع ذلك من
#  جذره: كلُّ قناةٍ خارجيةٍ تُحوَّل إلى المحلّي أو تُطفأ.
#
#  القيم هنا افتراضاتٌ فقط: أيُّ متغيّرٍ تضبطه في الطرفية قبل الأمر يتقدّم
#  عليها (هكذا يعمل Vite مع متغيّرات VITE_*).

# ── الباك المحلّي العامل على قاعدة attendance_system_test ──
VITE_API_BASE_URL=http://127.0.0.1:8010/api

# ── مقبس Reverb: يُوجَّه للمحلّي كي لا يفتح المتصفّح قناةً حيّةً إلى الإنتاج.
#    (درع Playwright يحجب xhr/fetch فقط — أمّا WebSocket فلا يمرّ عليه، فوجب
#     قطعُه من البناء لا من الزاحف.)
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8010
VITE_REVERB_SCHEME=http

# ── Firebase: يُطفأ بتفريغ مفاتيحه. التطبيق يتحمّل ذلك بلطف
#    (resolveFirebaseConfig يرى مفتاحاً ناقصاً فيُعطّل ميزات النداء الآلي
#     ويطبع console.warn لا console.error) — والبديل أن يفتح المتصفّح قاعدةَ
#     Firebase الإنتاجية الحقيقية أثناء الفحص، وهو ما لا يُحتمل.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
